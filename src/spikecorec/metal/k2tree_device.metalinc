// k^2-tree bit-walk device helpers, shared by the precompiled kernels in kernels.metal and
// the runtime-compiled master kernel.
//
// A runtime-compiled kernel has no include path, so the codegen reads this file from
// SPIKECOREC_METAL_DEVICE_DIR (set by the Makefile) and parses it into the kernel.
// Bodies of if, else, for and while must be braced: the codegen's parser requires it.

// ── k2tree bit-walk helpers ───────────────────────────────────────────────────
inline uint k2t_get_bit(const device uint *words, int bit_index) {
    return (words[bit_index >> 5] >> static_cast<uint>(bit_index & 31)) & 1u;
}

inline int k2t_rank1_exclusive(
    const device uint *internal_words,
    const device uint *superblock_table,
    const device ushort *subblock_table,
    int position,
    int superblock_size
) {
    int word_index = position >> 5;
    int bit_offset = position & 31;
    int superblock_index = word_index / superblock_size;
    uint superblock_base = superblock_table[superblock_index];
    uint subblock_base = static_cast<uint>(subblock_table[word_index]);
    uint partial_word_mask = (bit_offset == 0) ? 0u : ((1u << static_cast<uint>(bit_offset)) - 1u);
    uint partial_word_popcount = popcount(internal_words[word_index] & partial_word_mask);
    return static_cast<int>(superblock_base + subblock_base + partial_word_popcount);
}

#define MAX_K2TREE_HEIGHT 32

// Node indices are unsigned, so a walk that finds no node returns this (UINT_MAX) instead of -1.
#define K2T_NO_NEIGHBOR 4294967295u

// Returns row u's target_slot-th target (0-indexed, ascending), or K2T_NO_NEIGHBOR when u has
// fewer. Walks only populated subtrees on u's row. Iterative DFS with an explicit stack because
// Metal has no recursion; depth is tree_height, at most MAX_K2TREE_HEIGHT.
inline uint k2t_find_nth_neighbor(
    const device uint   *internal_node_words,
    const device uint   *leaf_node_words,
    const device uint   *rank_superblock_table,
    const device ushort *rank_subblock_table,
    int branching_factor,
    int superblock_size_words,
    int node_count,
    int padded_node_count,
    int tree_height,
    int internal_bit_count,
    uint u,
    int target_slot
) {
    if (tree_height == 0 || u >= static_cast<uint>(node_count) || target_slot < 0) {
        return K2T_NO_NEIGHBOR;
    }

    int branching_factor_squared = branching_factor * branching_factor;

    uint stack_row_base[MAX_K2TREE_HEIGHT];
    uint stack_col_base[MAX_K2TREE_HEIGHT];
    int stack_block_size[MAX_K2TREE_HEIGHT];
    int stack_bit_offset[MAX_K2TREE_HEIGHT];
    int stack_next_col[MAX_K2TREE_HEIGHT];

    stack_row_base[0] = 0;
    stack_col_base[0] = 0;
    stack_block_size[0] = padded_node_count;
    stack_bit_offset[0] = 0;
    stack_next_col[0] = 0;

    int stack_top = 0;
    int neighbors_seen = 0;

    while (stack_top >= 0) {
        int level = stack_top;
        int col_offset = stack_next_col[level];
        if (col_offset >= branching_factor) {
            stack_top--;
            continue;
        }
        stack_next_col[level] = col_offset + 1;

        uint row_base = stack_row_base[level];
        uint col_base = stack_col_base[level];
        int block_size = stack_block_size[level];
        int level_bit_offset = stack_bit_offset[level];

        int child_block_size = block_size / branching_factor;
        int row_offset = static_cast<int>((u - row_base) / static_cast<uint>(child_block_size));
        int child_flat_index = row_offset * branching_factor + col_offset;
        int bit_position = level_bit_offset + child_flat_index;

        if (level == tree_height - 1) {
            if (k2t_get_bit(leaf_node_words, bit_position)) {
                uint v = col_base + static_cast<uint>(col_offset);
                if (v < static_cast<uint>(node_count)) {
                    if (neighbors_seen == target_slot) {
                        return v;
                    }
                    neighbors_seen++;
                }
            }
        } else if (k2t_get_bit(internal_node_words, bit_position)) {
            int rank_inclusive = k2t_rank1_exclusive(internal_node_words, rank_superblock_table,
                                                      rank_subblock_table, bit_position, superblock_size_words) + 1;
            int child_level = stack_top + 1;
            int raw_offset = branching_factor_squared * rank_inclusive;
            stack_row_base[child_level] = row_base + static_cast<uint>(row_offset * child_block_size);
            stack_col_base[child_level] = col_base + static_cast<uint>(col_offset * child_block_size);
            stack_block_size[child_level] = child_block_size;
            stack_bit_offset[child_level] = (child_level == tree_height - 1)
                ? (raw_offset - internal_bit_count)
                : raw_offset;
            stack_next_col[child_level] = 0;
            stack_top = child_level;
        }
    }

    return K2T_NO_NEIGHBOR;
}

// Returns row u's next target, resuming the DFS from the caller's stack, or K2T_NO_NEIGHBOR when done.
// The caller owns the stack arrays (MAX_K2TREE_HEIGHT each) and initializes them once:
//   stack_row_base[0]=0, stack_col_base[0]=0, stack_block_size[0]=padded_node_count,
//   stack_bit_offset[0]=0, stack_next_col[0]=0, stack_top=0 (or -1 to short-circuit).
inline uint k2t_next_neighbor(
    const device uint   *internal_node_words,
    const device uint   *leaf_node_words,
    const device uint   *rank_superblock_table,
    const device ushort *rank_subblock_table,
    int branching_factor,
    int superblock_size_words,
    int node_count,
    int tree_height,
    int internal_bit_count,
    uint u,
    thread uint *stack_row_base,
    thread uint *stack_col_base,
    thread int *stack_block_size,
    thread int *stack_bit_offset,
    thread int *stack_next_col,
    thread int &stack_top
) {
    int branching_factor_squared = branching_factor * branching_factor;

    while (stack_top >= 0) {
        int level      = stack_top;
        int col_offset = stack_next_col[level];
        if (col_offset >= branching_factor) {
            stack_top--;
            continue;
        }
        stack_next_col[level] = col_offset + 1;

        uint row_base        = stack_row_base[level];
        uint col_base        = stack_col_base[level];
        int block_size       = stack_block_size[level];
        int level_bit_offset = stack_bit_offset[level];

        int child_block_size = block_size / branching_factor;
        int row_offset       = static_cast<int>((u - row_base) / static_cast<uint>(child_block_size));
        int child_flat_index = row_offset * branching_factor + col_offset;
        int bit_position     = level_bit_offset + child_flat_index;

        if (level == tree_height - 1) {
            if (k2t_get_bit(leaf_node_words, bit_position)) {
                uint v = col_base + static_cast<uint>(col_offset);
                if (v < static_cast<uint>(node_count)) {
                    return v;
                }
            }
        } else if (k2t_get_bit(internal_node_words, bit_position)) {
            int rank_inclusive = k2t_rank1_exclusive(internal_node_words, rank_superblock_table,
                                                      rank_subblock_table, bit_position, superblock_size_words) + 1;
            int child_level = stack_top + 1;
            int raw_offset  = branching_factor_squared * rank_inclusive;
            stack_row_base[child_level]   = row_base + static_cast<uint>(row_offset * child_block_size);
            stack_col_base[child_level]   = col_base + static_cast<uint>(col_offset * child_block_size);
            stack_block_size[child_level] = child_block_size;
            stack_bit_offset[child_level] = (child_level == tree_height - 1)
                ? (raw_offset - internal_bit_count)
                : raw_offset;
            stack_next_col[child_level] = 0;
            stack_top = child_level;
        }
    }
    return K2T_NO_NEIGHBOR;
}
