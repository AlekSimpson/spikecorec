<neuroml xmlns="http://www.neuroml.org/schema/neuroml2" id="PoissonPopulationTop">
  <!--
    A thin <include>-only wrapper so spikecorec's own front-end
    (tests/exit_model_validation_tests.cpp) parses poisson_population.nml
    without XSD-validating it as a TOP-LEVEL file - see
    glif3_single_cell_top.nml's own header comment for why. jNeuroML/jLEMS
    never sees this file - it consumes poisson_population.nml directly via
    LEMS_poisson_population.xml.
  -->
  <include href="poisson_population.nml"/>
</neuroml>
