<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.github.com/NeuroML/NeuroML2/master/Schemas/NeuroML2/NeuroML_v2.3.xsd"
         id="PoissonPopulationExitModel">

  <!--
    Phase-2 exit model #3 (ticket #67 [H2], arch §5 Phase 2): a
    Poisson-driven population generated on device (ticket #65 [F4]'s own
    `SpikeSourcePoisson` on-device generator, include/spikecorec/nml/
    inputs_lowering.h). 100 independent, unconnected
    `SpikeSourcePoisson` instances (a REAL vendored NeuroML ComponentType,
    third_party/neuroml2/std_lib/PyNN.xml - not a custom inline
    declaration), each firing at rate=10Hz.

    jLEMS genuinely simulates SpikeSourcePoisson (its own real, exponential-
    ISI renewal-process implementation - `isi = -log(random(1))/rate`,
    PyNN.xml's own Dynamics, driven by jLEMS's own PRNG, seeded via this
    file's own <Simulation seed="..."> for a reproducible checked-in
    capture), so a REAL reference spike raster IS captured here (not
    fabricated) - but per this ticket's own scope note, an exact,
    spike-for-spike comparison against spikecorec's own run is NOT a
    meaningful validation target: jLEMS's own renewal-process algorithm and
    spikecorec's own per-tick Bernoulli-style `rand`-driven algorithm
    (gpu_source.h's own `spikecorec_rand_uniform`, xorshift32) are two
    DIFFERENT ways of generating a rate-`rate` Poisson process, over two
    ENTIRELY DIFFERENT PRNG streams - neither is "the same random numbers"
    as the other, so no tick-by-tick or event-by-event correspondence
    between the two traces exists even in principle. What IS a genuine,
    meaningful cross-simulator comparison target - and what this exit
    model's own DISABLED_ comparison test
    (tests/exit_model_validation_tests.cpp) checks - is AGGREGATE spike
    statistics (total spike count / rate over the recorded window): both
    algorithms are valid samples of the SAME rate-`rate` Poisson process, so
    both should independently converge to the SAME expected count
    (population_size * rate * duration) within ordinary Poisson-process
    sampling variance (a chi-square-style, not exact, tolerance) -
    precisely the statistical self-consistency approach ticket #65's own
    inputs_lowering_tests.cpp already established for spikecorec's own run
    in isolation, now ALSO validated against a real, independently-generated
    jLEMS reference sample at a larger (100-neuron,
    8s) population scale than that ticket's own
    50-neuron/5s unit test, and framed explicitly as this ticket's own
    validation exit model (not merely unit coverage).
  -->
  <!-- rate uses "per_s" rather than the equivalent "Hz" - spikecorec's own unit table
       (src/core/time_utilities.cpp) does not recognize "Hz" as a unit symbol (only "per_s"/
       "per_ms", a narrowly-scoped, pre-existing front-end gap out of this ticket's own scope to
       widen); "per_s" is an equally real, NeuroML-declared unit for the identical physical
       quantity (NeuroMLCoreDimensions.xml's own per_time dimension), so this is a like-for-like
       substitution, not an approximation. -->
  <SpikeSourcePoisson id="poissonInstance" start="0ms" duration="1000s" rate="10per_s"/>

  <network id="PoissonNet">
    <population id="PoissonPop" component="poissonInstance" size="100"/>
  </network>

  <Simulation id="sim1" length="8s" step="1ms" target="PoissonNet" seed="17">
    <EventOutputFile id="spikesFile" fileName="poisson_population_spikes.dat" format="TIME_ID">
      <EventSelection id="sel0" select="PoissonPop[0]" eventPort="spike"/>
      <EventSelection id="sel1" select="PoissonPop[1]" eventPort="spike"/>
      <EventSelection id="sel2" select="PoissonPop[2]" eventPort="spike"/>
      <EventSelection id="sel3" select="PoissonPop[3]" eventPort="spike"/>
      <EventSelection id="sel4" select="PoissonPop[4]" eventPort="spike"/>
      <EventSelection id="sel5" select="PoissonPop[5]" eventPort="spike"/>
      <EventSelection id="sel6" select="PoissonPop[6]" eventPort="spike"/>
      <EventSelection id="sel7" select="PoissonPop[7]" eventPort="spike"/>
      <EventSelection id="sel8" select="PoissonPop[8]" eventPort="spike"/>
      <EventSelection id="sel9" select="PoissonPop[9]" eventPort="spike"/>
