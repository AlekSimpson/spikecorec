<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.github.com/NeuroML/NeuroML2/master/Schemas/NeuroML2/NeuroML_v2.3.xsd"
         id="Glif5SingleCellExitModel">

  <!--
    Ticket #125 [T4] exit model: a GLIF5 single cell reproducing after-spike
    currents (`asc1`/`asc2`, as GLIF3) COMBINED with an adapting threshold
    (`theta`, as GLIF4), the most complex of the five GLIF variants, under
    a current step. The ComponentType below is the SAME GLIF5Cell declaration
    tests/cell_lowering_tests.cpp's own GLIF5_COMPONENT_TYPE fixture uses,
    reused verbatim here so the SAME .nml file drives BOTH pyneuroml/jNeuroML
    (real reference trace/spike capture) and spikecorec's own
    parse->resolve->lower->IR->AssembledModel pipeline (see
    tests/exit_model_validation_tests.cpp), mirroring glif3_single_cell.nml's
    own established convention exactly (ticket #61 [H1]). Parameters/
    pulseGenerator/Simulation window are identical to glif3_single_cell.nml's
    own (C/gL/EL/vreset/t_ref/tauAsc1/tauAsc2/ascAdd1/ascAdd2, 20ms/300ms/
    0.6nA pulse, 350ms/0.1ms run) plus the same adapting-threshold parameters
    glif4_single_cell.nml's own uses (thetaInf/tauTheta/thetaSpikeAdd), so a
    reviewer can directly compare GLIF5's combined spike-frequency-adaptation
    signature (both mechanisms acting together) against GLIF3's/GLIF4's own
    individual ones under the exact same drive.
  -->
  <ComponentType name="GLIF5Cell" extends="baseCell">
    <Parameter name="C" dimension="capacitance"/>
    <Parameter name="gL" dimension="conductance"/>
    <Parameter name="EL" dimension="voltage"/>
    <Parameter name="vreset" dimension="voltage"/>
    <Parameter name="t_ref" dimension="time"/>
    <Parameter name="thetaInf" dimension="voltage"/>
    <Parameter name="tauTheta" dimension="time"/>
    <Parameter name="thetaSpikeAdd" dimension="voltage"/>
    <Parameter name="tauAsc1" dimension="time"/>
    <Parameter name="tauAsc2" dimension="time"/>
    <Parameter name="ascAdd1" dimension="current"/>
    <Parameter name="ascAdd2" dimension="current"/>
    <Attachments name="synapses" type="basePointCurrent"/>
    <EventPort name="spike" direction="out"/>
    <Exposure name="v" dimension="voltage"/>
    <Exposure name="theta" dimension="voltage"/>
    <Exposure name="asc1" dimension="current"/>
    <Exposure name="asc2" dimension="current"/>
    <Exposure name="iSyn" dimension="current"/>
    <Dynamics>
      <StateVariable name="v" dimension="voltage" exposure="v"/>
      <StateVariable name="theta" dimension="voltage" exposure="theta"/>
      <StateVariable name="asc1" dimension="current" exposure="asc1"/>
      <StateVariable name="asc2" dimension="current" exposure="asc2"/>
      <StateVariable name="refractoryTimeElapsed" dimension="time"/>
      <DerivedVariable name="iSyn" dimension="current" exposure="iSyn" select="synapses[*]/i" reduce="add"/>
      <DerivedVariable name="ascSum" dimension="current" value="asc1 + asc2"/>
      <TimeDerivative variable="theta" value="(thetaInf - theta) / tauTheta"/>
      <TimeDerivative variable="asc1" value="-asc1 / tauAsc1"/>
      <TimeDerivative variable="asc2" value="-asc2 / tauAsc2"/>
      <OnStart>
        <StateAssignment variable="v" value="EL"/>
        <StateAssignment variable="theta" value="thetaInf"/>
        <StateAssignment variable="asc1" value="0"/>
        <StateAssignment variable="asc2" value="0"/>
      </OnStart>
      <Regime name="integrating" initial="true">
        <TimeDerivative variable="v" value="(gL * (EL - v) + iSyn + ascSum) / C"/>
        <OnCondition test="v .gt. theta">
          <EventOut port="spike"/>
          <StateAssignment variable="v" value="vreset"/>
          <StateAssignment variable="theta" value="theta + thetaSpikeAdd"/>
          <StateAssignment variable="asc1" value="asc1 + ascAdd1"/>
          <StateAssignment variable="asc2" value="asc2 + ascAdd2"/>
          <Transition regime="refractory"/>
        </OnCondition>
      </Regime>
      <Regime name="refractory">
        <OnEntry>
          <StateAssignment variable="refractoryTimeElapsed" value="0"/>
        </OnEntry>
        <TimeDerivative variable="refractoryTimeElapsed" value="1"/>
        <OnCondition test="refractoryTimeElapsed .geq. t_ref">
          <Transition regime="integrating"/>
        </OnCondition>
      </Regime>
    </Dynamics>
  </ComponentType>

  <GLIF5Cell id="glif5CellInstance" C="100pF" gL="10nS" EL="-70mV" vreset="-70mV" t_ref="5ms"
             thetaInf="-50mV" tauTheta="50ms" thetaSpikeAdd="5mV" tauAsc1="100ms" tauAsc2="10ms"
             ascAdd1="-100pA" ascAdd2="-200pA"/>

  <pulseGenerator id="pulseGen1" delay="20ms" duration="300ms" amplitude="0.6nA"/>

  <network id="Glif5Net">
    <population id="Glif5Pop" component="glif5CellInstance" size="1"/>
    <explicitInput target="Glif5Pop[0]" input="pulseGen1"/>
  </network>

  <Simulation id="sim1" length="350ms" step="0.1ms" target="Glif5Net">
    <OutputFile id="membraneTrace" fileName="glif5_membrane_trace.dat">
      <OutputColumn id="v" quantity="Glif5Pop[0]/v"/>
      <OutputColumn id="theta" quantity="Glif5Pop[0]/theta"/>
      <OutputColumn id="asc1" quantity="Glif5Pop[0]/asc1"/>
      <OutputColumn id="asc2" quantity="Glif5Pop[0]/asc2"/>
    </OutputFile>
    <EventOutputFile id="spikesFile" fileName="glif5_spikes.dat" format="TIME_ID">
      <EventSelection id="sel0" select="Glif5Pop[0]" eventPort="spike"/>
    </EventOutputFile>
  </Simulation>
</neuroml>
