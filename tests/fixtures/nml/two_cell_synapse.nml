<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.github.com/NeuroML/NeuroML2/development/Schemas/NeuroML2/NeuroML_v2.3.xsd"
         id="TwoCellSynapse">

    <!--
      Two driven sources feed one target through one projection, so the target sums two edges.
      tau = C / leakConductance = 100 pF / 5 nS = 20 ms; rheobase = 5 nS * 15 mV = 75 pA.
      The sources get 90 pA and fire regularly. The target's 60 pA is below rheobase, so it
      fires only through the synapse. The weights differ, so ignoring weight changes the result.
    -->

    <iafCell id="sourceCell"
             leakConductance="5 nS"
             leakReversal="-65 mV"
             thresh="-50 mV"
             reset="-70 mV"
             C="100 pF"/>

    <iafCell id="targetCell"
             leakConductance="5 nS"
             leakReversal="-65 mV"
             thresh="-50 mV"
             reset="-70 mV"
             C="100 pF"/>

    <!--
      Current-based: i = I, dI/dt = (e*J - I) / tau, dJ/dt = -J / tau;
      each arrival adds weight * ibase to J.
    -->
    <alphaCurrentSynapse id="excitatorySynapse" tau="2 ms" ibase="40 pA"/>

    <pulseGenerator id="sourceDrive" delay="0 ms" duration="200 ms" amplitude="90 pA"/>
    <pulseGenerator id="subThresholdDrive" delay="0 ms" duration="200 ms" amplitude="60 pA"/>

    <network id="twoCellNetwork">
        <population id="sourcePopulation" component="sourceCell" size="2"/>
        <population id="targetPopulation" component="targetCell" size="1"/>

        <projection id="excitatoryProjection"
                    presynapticPopulation="sourcePopulation"
                    postsynapticPopulation="targetPopulation"
                    synapse="excitatorySynapse">
            <connectionWD id="0"
                          preCellId="../sourcePopulation[0]"
                          postCellId="../targetPopulation[0]"
                          weight="1.0"
                          delay="1 ms"/>
            <connectionWD id="1"
                          preCellId="../sourcePopulation[1]"
                          postCellId="../targetPopulation[0]"
                          weight="0.5"
                          delay="1 ms"/>
        </projection>

        <explicitInput target="sourcePopulation[0]" input="sourceDrive"/>
        <explicitInput target="sourcePopulation[1]" input="sourceDrive"/>
        <explicitInput target="targetPopulation[0]" input="subThresholdDrive"/>
    </network>

</neuroml>
