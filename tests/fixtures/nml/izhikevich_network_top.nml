<neuroml xmlns="http://www.neuroml.org/schema/neuroml2" id="IzhikevichNetworkTop">
  <!--
    A thin <include>-only wrapper so spikecorec's own front-end
    (tests/exit_model_validation_tests.cpp) parses izhikevich_network.nml
    without XSD-validating it as a TOP-LEVEL file - see
    glif3_single_cell_top.nml's own header comment for why. jNeuroML/jLEMS
    never sees this file - it consumes izhikevich_network.nml directly via
    LEMS_izhikevich_network.xml.
  -->
  <include href="izhikevich_network.nml"/>
</neuroml>
