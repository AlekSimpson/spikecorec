CompileFlags:
  Compiler: clang++
  Add:
    - "-std=c++17"
    - "-Isrc"
    - "-Isrc/spikecorec/core"
    - "-Isrc/spikecorec/nml"
    - "-Isrc/spikecorec/cuda"
    - "-Isrc/spikecorec/metal"
    - "-Ithird_party/metal-cpp"
    - "-DSPIKECOREC_METAL"

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - "pp_file_not_found"

Index:
  Background: Build
