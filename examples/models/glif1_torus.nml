<neuroml xmlns="http://www.neuroml.org/schema/neuroml2" id="Glif1Torus">

    <!--
      A 5x5 sheet of GLIF1 cells wired as a torus. The wiring is supplied from Python,
      not declared here: this document says only what the cells and the synapses are, and
      how they are driven.

      Two synapses are on offer and the engine assigns one per cell, which is what makes
      a cell excitatory or inhibitory. All of a cell's outgoing edges carry its own
      synapse, so a cell is one thing or the other rather than a mixture.

      GLIF1 with C = 100 pF and gL = 10 nS has a 10 ms membrane time constant and a
      rheobase of gL * (vth EL) = 200 pA. The 5 seeded cells are driven over it and fire
      on their own; every other cell settles at EL + I/gL = -54 mV, 4 mV under threshold,
      and fires only when spikes arrive along its edges.

      An arrival delivers a charge of e * ibase * tau, but the membrane leaks while that
      current is still arriving, so the peak is about a third of the 8.1 mV that charge
      would be worth instantly: roughly 2.8 mV excitatory against a 4 mV gap. Two
      arrivals inside tau fire a background cell and one does not, which is what stops
      the first wave saturating the sheet. Inhibition is four times as strong, so with a
      4:1 excitatory:inhibitory split the two roughly cancel.
    -->

    <include href="glif_cell_types.nml"/>

    <GLIF1Cell id="sheetCell" C="100pF" gL="10nS" EL="-70mV" vreset="-70mV"
               t_ref="5ms" vth="-50mV"/>

    <alphaCurrentSynapse id="excitatorySynapse" tau="5ms" ibase="60pA"/>
    <alphaCurrentSynapse id="inhibitorySynapse" tau="5ms" ibase="-240pA"/>

    <pulseGenerator id="seedDrive" delay="0ms" duration="500ms" amplitude="260pA"/>
    <pulseGenerator id="backgroundDrive" delay="0ms" duration="500ms" amplitude="160pA"/>

    <network id="sheetNetwork">
        <population id="sheet" component="sheetCell" size="25"/>

        <explicitInput target="sheet[0]" input="seedDrive"/>
        <explicitInput target="sheet[1]" input="backgroundDrive"/>
        <explicitInput target="sheet[2]" input="backgroundDrive"/>
        <explicitInput target="sheet[3]" input="backgroundDrive"/>
        <explicitInput target="sheet[4]" input="backgroundDrive"/>
        <explicitInput target="sheet[5]" input="backgroundDrive"/>
        <explicitInput target="sheet[6]" input="seedDrive"/>
        <explicitInput target="sheet[7]" input="backgroundDrive"/>
        <explicitInput target="sheet[8]" input="backgroundDrive"/>
        <explicitInput target="sheet[9]" input="backgroundDrive"/>
        <explicitInput target="sheet[10]" input="backgroundDrive"/>
        <explicitInput target="sheet[11]" input="backgroundDrive"/>
        <explicitInput target="sheet[12]" input="seedDrive"/>
        <explicitInput target="sheet[13]" input="backgroundDrive"/>
        <explicitInput target="sheet[14]" input="backgroundDrive"/>
        <explicitInput target="sheet[15]" input="backgroundDrive"/>
        <explicitInput target="sheet[16]" input="backgroundDrive"/>
        <explicitInput target="sheet[17]" input="backgroundDrive"/>
        <explicitInput target="sheet[18]" input="seedDrive"/>
        <explicitInput target="sheet[19]" input="backgroundDrive"/>
        <explicitInput target="sheet[20]" input="backgroundDrive"/>
        <explicitInput target="sheet[21]" input="backgroundDrive"/>
        <explicitInput target="sheet[22]" input="backgroundDrive"/>
        <explicitInput target="sheet[23]" input="backgroundDrive"/>
        <explicitInput target="sheet[24]" input="seedDrive"/>
    </network>

</neuroml>
