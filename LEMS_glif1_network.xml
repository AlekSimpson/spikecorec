<Lems>
    <!-- Runs glif1_network.nml for 200 ms; build/cli loads this file by relative path. -->
    <Include file="Cells.xml"/>
    <Include file="Synapses.xml"/>
    <Include file="Inputs.xml"/>
    <Include file="Networks.xml"/>
    <Include file="Simulation.xml"/>
    <Include file="glif1_network.nml"/>

    <Simulation id="glif1Simulation" length="200ms" step="0.05ms" target="glif1Network"/>

    <Target component="glif1Simulation"/>
</Lems>
